{
  "name": "@mulmoclaude/decisions-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI Decisions API runtime plugin for MulmoClaude — fast, calibrated predicate / choice / score answers over a batch of texts and images, rendered as a table. Dev-only preset until published.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.js",
      "default": "./dist/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@mulmoclaude/common": "^1.2.0"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^2.0.0",
    "vue": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.9",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/plugins/decisions-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/plugins/decisions-plugin"
  },
  "keywords": [
    "openai",
    "decisions",
    "classification",
    "mulmoclaude",
    "mulmoclaude-plugin",
    "gui-chat-protocol",
    "claude-code"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
